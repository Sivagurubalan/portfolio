---
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/nav.astro";
import Footer from "@/components/footer.astro";
import { site } from "@/data/site";
import type { Project } from "@/data/site";

interface Props {
  project: Project;
}

export function getStaticPaths() {
  return site.projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props as Props;
const meta = project.caseStudy;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");

const index = site.projects.findIndex((item) => item.slug === project.slug);
const previous = index > 0 ? site.projects[index - 1] : undefined;
const next =
  index < site.projects.length - 1 ? site.projects[index + 1] : undefined;

const sections = [
  "Overview",
  "Problem",
  "System architecture",
  "Technologies",
  "What I built",
  "Testing & results",
  "Future improvements",
];
---

<Layout
  title={`${project.title} — case study | ${site.name}`}
  description={project.summary}
>
  <Nav prefix="/" />

  <main class="text-[var(--white)] pt-10 md:pt-16">
    <div class="max-w-3xl mx-auto">
      <a
        href={`${baseUrl}/#work`}
        class="inline-flex items-center gap-2 text-xs uppercase tracking-[0.2em] text-[var(--white-icon)] transition hover:text-[var(--sec)]"
      >
        <span aria-hidden="true">←</span> Back to work
      </a>

      <p class="mt-8 text-[11px] uppercase tracking-[0.3em] text-[var(--sec)]">
        Case study · {project.kicker}
      </p>
      <h1 class="mt-3 text-3xl md:text-5xl font-medium leading-tight text-pretty">
        {project.title}
      </h1>
      <p class="mt-4 text-sm md:text-base leading-relaxed text-[var(--white-icon)]">
        {meta.overview}
      </p>

      <dl
        class="mt-7 grid grid-cols-2 sm:grid-cols-4 gap-4 border-y border-[#ffffff10] py-5 text-sm"
      >
        <div>
          <dt class="text-[10px] uppercase tracking-[0.2em] text-[#7d858d]">
            Status
          </dt>
          <dd class="mt-1">{project.status}</dd>
        </div>
        <div>
          <dt class="text-[10px] uppercase tracking-[0.2em] text-[#7d858d]">
            Year
          </dt>
          <dd class="mt-1">{project.year}</dd>
        </div>
        <div>
          <dt class="text-[10px] uppercase tracking-[0.2em] text-[#7d858d]">
            Discipline
          </dt>
          <dd class="mt-1">{project.cats.join(" · ")}</dd>
        </div>
        <div>
          <dt class="text-[10px] uppercase tracking-[0.2em] text-[#7d858d]">
            Links
          </dt>
          <dd class="mt-1 flex flex-col gap-1">
            {
              project.codeUrl && (
                <a
                  href={project.codeUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-[var(--sec)] hover:underline"
                >
                  Source code
                </a>
              )
            }
            {
              project.liveUrl && (
                <a
                  href={project.liveUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-[var(--sec)] hover:underline"
                >
                  Live demo
                </a>
              )
            }
            {
              !project.codeUrl && !project.liveUrl && (
                <span class="text-[#7d858d]">Not public yet</span>
              )
            }
          </dd>
        </div>
      </dl>

      <img
        src={`${baseUrl}${project.image}`}
        alt={`${project.title} cover`}
        class="mt-8 w-full rounded-2xl border border-[#ffffff12]"
        loading="eager"
        decoding="async"
      />

      <nav class="mt-8 rounded-2xl border border-[#ffffff10] bg-[#101418] p-5">
        <p class="text-[10px] uppercase tracking-[0.2em] text-[#7d858d]">
          In this case study
        </p>
        <ol class="mt-3 grid grid-cols-1 sm:grid-cols-2 gap-1.5">
          {
            sections.map((section, i) => (
              <li class="text-sm text-[var(--white-icon)]">
                <span class="font-mono text-[11px] text-[var(--sec)] mr-2">
                  {String(i + 1).padStart(2, "0")}
                </span>
                {section}
              </li>
            ))
          }
        </ol>
      </nav>

      <div class="mt-12 space-y-12">
        <section>
          <h2 class="flex items-baseline gap-3 text-xl md:text-2xl font-semibold">
            <span class="font-mono text-xs text-[var(--sec)]">01</span>
            Overview
          </h2>
          <p class="mt-3 text-sm md:text-base leading-relaxed text-[var(--white-icon)]">
            {meta.overview}
          </p>
          <p class="mt-3 text-sm md:text-base leading-relaxed text-[var(--white-icon)]">
            <span class="text-[var(--white)]">Why I built it. </span>
            {meta.reasoning}
          </p>
        </section>

        <section>
          <h2 class="flex items-baseline gap-3 text-xl md:text-2xl font-semibold">
            <span class="font-mono text-xs text-[var(--sec)]">02</span>
            Problem
          </h2>
          <p class="mt-3 text-sm md:text-base leading-relaxed text-[var(--white-icon)]">
            {meta.problem}
          </p>
        </section>

        <section>
          <h2 class="flex items-baseline gap-3 text-xl md:text-2xl font-semibold">
            <span class="font-mono text-xs text-[var(--sec)]">03</span>
            System architecture
          </h2>
          <ol class="mt-4 space-y-3">
            {
              meta.architecture.map((step, i) => (
                <li class="flex gap-4 rounded-xl border border-[#ffffff10] bg-[#101418] p-4">
                  <span class="font-mono text-[11px] text-[var(--sec)] pt-0.5">
                    {String(i + 1).padStart(2, "0")}
                  </span>
                  <div>
                    <p class="text-sm font-medium">{step.label}</p>
                    <p class="mt-1 text-sm leading-relaxed text-[var(--white-icon)]">
                      {step.detail}
                    </p>
                  </div>
                </li>
              ))
            }
          </ol>
        </section>

        <section>
          <h2 class="flex items-baseline gap-3 text-xl md:text-2xl font-semibold">
            <span class="font-mono text-xs text-[var(--sec)]">04</span>
            Technologies
          </h2>
          <dl class="mt-4 divide-y divide-[#ffffff0d] border-y border-[#ffffff10]">
            {
              meta.tech.map((item) => (
                <div class="grid gap-1 py-3 sm:grid-cols-[180px_1fr] sm:gap-4">
                  <dt class="text-sm font-medium">{item.name}</dt>
                  <dd class="text-sm text-[var(--white-icon)]">{item.use}</dd>
                </div>
              ))
            }
          </dl>
        </section>

        <section>
          <h2 class="flex items-baseline gap-3 text-xl md:text-2xl font-semibold">
            <span class="font-mono text-xs text-[var(--sec)]">05</span>
            What I built
          </h2>
          <ul class="mt-4 space-y-2.5">
            {
              meta.contribution.map((item) => (
                <li class="flex gap-3 text-sm md:text-base leading-relaxed text-[var(--white-icon)]">
                  <span class="mt-2 size-1.5 shrink-0 rounded-full bg-[var(--sec)]" />
                  {item}
                </li>
              ))
            }
          </ul>
        </section>

        <section>
          <h2 class="flex items-baseline gap-3 text-xl md:text-2xl font-semibold">
            <span class="font-mono text-xs text-[var(--sec)]">06</span>
            Testing &amp; results
          </h2>
          <ul class="mt-4 space-y-2.5">
            {
              meta.testing.map((item) => (
                <li class="flex gap-3 text-sm md:text-base leading-relaxed text-[var(--white-icon)]">
                  <span class="mt-2 size-1.5 shrink-0 rounded-full bg-[var(--sec)]" />
                  {item}
                </li>
              ))
            }
          </ul>
          {
            meta.caveat && (
              <p class="mt-5 rounded-xl border border-[#f5b45a33] bg-[#f5b45a0d] p-4 text-sm leading-relaxed text-[#e8c99a]">
                <span class="font-medium">Limitation. </span>
                {meta.caveat}
              </p>
            )
          }
        </section>

        <section>
          <h2 class="flex items-baseline gap-3 text-xl md:text-2xl font-semibold">
            <span class="font-mono text-xs text-[var(--sec)]">07</span>
            Future improvements
          </h2>
          <ul class="mt-4 space-y-2.5">
            {
              meta.future.map((item) => (
                <li class="flex gap-3 text-sm md:text-base leading-relaxed text-[var(--white-icon)]">
                  <span class="mt-2 size-1.5 shrink-0 rounded-full bg-[#ffffff33]" />
                  {item}
                </li>
              ))
            }
          </ul>
        </section>
      </div>

      <div class="mt-14 grid gap-4 border-t border-[#ffffff10] pt-8 sm:grid-cols-2">
        {
          previous && (
            <a
              href={`${baseUrl}/work/${previous.slug}`}
              class="rounded-2xl border border-[#ffffff10] bg-[#101418] p-5 transition hover:border-[#ffffff26]"
            >
              <span class="text-[10px] uppercase tracking-[0.2em] text-[#7d858d]">
                Previous
              </span>
              <p class="mt-1.5 text-sm font-medium">{previous.title}</p>
            </a>
          )
        }
        {
          next && (
            <a
              href={`${baseUrl}/work/${next.slug}`}
              class="rounded-2xl border border-[#ffffff10] bg-[#101418] p-5 text-right transition hover:border-[#ffffff26]"
            >
              <span class="text-[10px] uppercase tracking-[0.2em] text-[#7d858d]">
                Next
              </span>
              <p class="mt-1.5 text-sm font-medium">{next.title}</p>
            </a>
          )
        }
      </div>

      <a
        href={`${baseUrl}/#contact`}
        class="mt-8 flex items-center justify-center rounded-full border border-[var(--white-icon-tr)] bg-[#1414149c] p-3 text-sm text-[var(--white-icon)] transition hover:border-[var(--sec)] hover:text-white"
      >
        Working on something similar? Get in touch
      </a>
    </div>
  </main>

  <Footer />
</Layout>
