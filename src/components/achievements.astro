---
import { site } from "@/data/site";
const { achievement } = site;
---

<section id="achievements" class="py-14 md:py-16 border-t border-[#ffffff10] text-[var(--white)]">
  <div class="max-w-5xl mx-auto">
    <p class="text-xs uppercase tracking-[0.3em] text-[var(--sec)] mb-3">
      04 — Recognition
    </p>
    <div
      class="relative overflow-hidden rounded-3xl border border-[var(--sec)]/25 bg-[#181920] p-6 md:p-9 shadow-[0_12px_40px_rgba(0,0,0,0.45)]"
    >
      <div
        class="pointer-events-none absolute -right-16 -top-20 size-64 rounded-full bg-[var(--sec)]/15 blur-3xl"
      >
      </div>

      <div class="relative grid gap-8 md:grid-cols-[1.1fr_1fr]">
        <div>
          <p
            class="inline-flex items-center gap-2 rounded-full border border-[var(--sec)]/40 bg-[var(--sec)]/10 px-3 py-1 text-[11px] uppercase tracking-[0.2em] text-[var(--sec)]"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              class="size-3.5"
            >
              <path
                d="M12 2l2.9 6.26 6.86.72-5.1 4.6 1.4 6.72L12 17.02 5.94 20.3l1.4-6.72-5.1-4.6 6.86-.72L12 2z"
              ></path>
            </svg>
            {achievement.label}
          </p>
          <h2 class="mt-4 text-2xl md:text-4xl font-semibold leading-tight">
            {achievement.title}
          </h2>
          <p class="mt-2 text-sm text-[var(--white-icon)]">
            {achievement.event}
          </p>

          <dl class="mt-6 space-y-2 text-sm">
            <div class="flex gap-3">
              <dt class="w-24 shrink-0 text-[10px] uppercase tracking-[0.2em] text-[#7d858d] pt-1">
                Organiser
              </dt>
              <dd class="text-[var(--white-icon)]">{achievement.organiser}</dd>
            </div>
            <div class="flex gap-3">
              <dt class="w-24 shrink-0 text-[10px] uppercase tracking-[0.2em] text-[#7d858d] pt-1">
                Date
              </dt>
              <dd class="text-[var(--white-icon)]">{achievement.date}</dd>
            </div>
            <div class="flex gap-3">
              <dt class="w-24 shrink-0 text-[10px] uppercase tracking-[0.2em] text-[#7d858d] pt-1">
                Team
              </dt>
              <dd class="text-[var(--white-icon)]">
                {achievement.teammate} &amp; me
              </dd>
            </div>
          </dl>
        </div>

        <div class="space-y-5 text-sm leading-relaxed">
          <div>
            <p class="text-[10px] uppercase tracking-[0.2em] text-[var(--sec)]">
              The challenge
            </p>
            <p class="mt-1.5 text-[var(--white-icon)]">
              {achievement.challenge}
            </p>
          </div>
          <div>
            <p class="text-[10px] uppercase tracking-[0.2em] text-[var(--sec)]">
              How we approached it
            </p>
            <p class="mt-1.5 text-[var(--white-icon)]">
              {achievement.approach}
            </p>
          </div>
          <div>
            <p class="text-[10px] uppercase tracking-[0.2em] text-[var(--sec)]">
              What it taught me
            </p>
            <p class="mt-1.5 text-[var(--white-icon)]">
              {achievement.takeaway}
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
