---
import { site } from "@/data/site";

const emailLink = `mailto:${site.email}`;
---

<section id="contact" class="w-full py-12 border-t border-[#ffffff10]">
  <div class="max-w-5xl mx-auto">
    <p class="text-xs uppercase tracking-[0.3em] text-[var(--sec)] mb-3">
      08 — Contact &amp; opportunities
    </p>
    <h2 class="text-3xl md:text-5xl font-medium text-[var(--white)] mb-6">
      Let's build something that works outside a browser.
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div class="text-[var(--white-icon)]">
        <p class="mb-4 max-w-md leading-relaxed">{site.contactHeading}</p>
        <div class="flex items-center gap-2">
          <span>Location:</span>
          <span class="text-[var(--white)]">{site.location}</span>
        </div>
        <div class="flex items-center gap-2 mt-2">
          <span>Email:</span>
          <a
            href={emailLink}
            class="text-[var(--white)] hover:text-[var(--sec)] transition-colors"
          >
            {site.email}
          </a>
        </div>
        <ul class="mt-6 flex flex-wrap gap-2">
          {
            site.availability.map((item) => (
              <li class="rounded-full border border-[var(--white-icon-tr)] bg-[#181920] px-3 py-1 text-xs uppercase tracking-wider text-[var(--white-icon)]">
                {item}
              </li>
            ))
          }
        </ul>
        <p class="mt-4 text-sm">{site.contactNote}</p>
      </div>

      <div>
        <form
          id="contact-form"
          data-endpoint={site.formspreeEndpoint}
          data-email={site.email}
          method="POST"
          class="flex flex-col gap-4"
        >
          <label class="sr-only" for="contact-name">Name</label>
          <input
            id="contact-name"
            type="text"
            name="from_name"
            placeholder="Name"
            required
            class="px-4 py-2.5 bg-[#181920] text-[var(--white)] border border-[var(--white-icon-tr)] rounded-xl focus:outline-none focus:ring-2 focus:ring-[var(--sec)] focus:border-transparent transition"
          />
          <label class="sr-only" for="contact-email">Email</label>
          <input
            id="contact-email"
            type="email"
            name="reply_to"
            placeholder="Email"
            required
            class="px-4 py-2.5 bg-[#181920] text-[var(--white)] border border-[var(--white-icon-tr)] rounded-xl focus:outline-none focus:ring-2 focus:ring-[var(--sec)] focus:border-transparent transition"
          />
          <label class="sr-only" for="contact-message">Message</label>
          <textarea
            id="contact-message"
            name="message"
            placeholder="Message"
            rows="6"
            required
            class="px-4 py-2.5 bg-[#181920] text-[var(--white)] border border-[var(--white-icon-tr)] rounded-xl focus:outline-none focus:ring-2 focus:ring-[var(--sec)] focus:border-transparent transition resize-none"
          ></textarea>
          <button
            type="submit"
            class="px-6 py-3 bg-[var(--sec)] text-[#0d0e12] font-semibold rounded-xl transition duration-300 hover:brightness-110 shadow-[0_0_20px_rgba(168,85,247,0.35)]"
          >
            Submit
          </button>
        </form>
        <div
          id="form-message"
          class="hidden justify-center items-center mt-4 text-[var(--white)] text-lg"
          role="status"
        >
        </div>
      </div>
    </div>
  </div>
</section>

<script type="module" is:inline>
  const form = document.getElementById("contact-form");
  const formMessage = document.getElementById("form-message");

  const showMessage = (text) => {
    formMessage.textContent = text;
    formMessage.classList.remove("hidden");
    formMessage.classList.add("flex");
  };

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    const formData = new FormData(form);
    const endpoint = form.dataset.endpoint;

    // No backend configured yet: hand the message to the visitor's mail app.
    if (!endpoint) {
      const name = formData.get("from_name") || "";
      const email = formData.get("reply_to") || "";
      const message = formData.get("message") || "";
      const subject = encodeURIComponent(`Portfolio message from ${name}`);
      const body = encodeURIComponent(`${message}\n\n— ${name} (${email})`);
      window.location.href = `mailto:${form.dataset.email}?subject=${subject}&body=${body}`;
      showMessage("Opening your email app to send this message.");
      return;
    }

    try {
      const response = await fetch(endpoint, {
        method: "POST",
        body: formData,
        headers: { Accept: "application/json" },
      });
      if (response.ok) {
        form.reset();
        form.style.display = "none";
        showMessage("✅ Thank you for your message!");
      } else {
        const data = await response.json();
        console.error("Error response:", data);
        alert("There was a problem sending your message.");
      }
    } catch (error) {
      console.error("Error:", error);
      alert("There was a problem sending your message.");
    }
  });
</script>
