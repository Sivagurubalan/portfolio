---
import { site } from "@/data/site";
---

<section
  id="focus"
  class="py-14 md:py-16 border-t border-[#ffffff10] text-[var(--white)]"
>
  <div class="max-w-5xl mx-auto">
    <p class="text-xs uppercase tracking-[0.3em] text-[var(--sec)] mb-3">
      01 — Engineering focus
    </p>
    <h2 class="text-3xl md:text-5xl font-medium text-pretty max-w-2xl">
      Four disciplines, one system mindset.
    </h2>
    <p class="mt-4 max-w-2xl text-sm md:text-base leading-relaxed text-[var(--white-icon)]">
      The value is not any single stack. It is that these four areas meet in the
      same build — software that has to drive something physical, hardware that
      has to report back.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mt-8">
      {
        site.focus.map((area, index) => (
          <a
            href="#work"
            data-focus={area.cats.join(",")}
            class="group flex flex-col rounded-2xl border border-[var(--white-icon-tr)] bg-[#181920] p-5 transition duration-300 hover:border-[var(--sec)]/60 hover:bg-[#1e2029] shadow-[0_8px_25px_rgba(0,0,0,0.3)]"
          >
            <span class="font-mono text-xs text-[var(--sec)]">
              {String(index + 1).padStart(2, "0")}
            </span>
            <h3 class="mt-4 text-lg font-semibold leading-snug">
              {area.title}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-[var(--white-icon)]">
              {area.summary}
            </p>
            <p class="mt-3 text-xs leading-relaxed text-[#8d949c]">
              {area.detail}
            </p>
            <ul class="mt-auto pt-5 flex flex-wrap gap-1.5">
              {area.tags.map((tag) => (
                <li class="rounded border border-[#ffffff12] px-2 py-1 text-[10px] uppercase tracking-wider text-[var(--white-icon)]">
                  {tag}
                </li>
              ))}
            </ul>
          </a>
        ))
      }
    </div>
  </div>
</section>
