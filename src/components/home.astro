---
import LogoWall from "../components/logoWall.astro";
import { site } from "@/data/site";

const { hero } = site;

const socialLinks = [
  {
    label: "GitHub",
    href: site.githubUrl,
    path: "M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.5135 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z",
  },
  {
    label: "LinkedIn",
    href: site.linkedinUrl,
    path: "M18.3362 18.339H15.6707V14.1622C15.6707 13.1662 15.6505 11.8845 14.2817 11.8845C12.892 11.8845 12.6797 12.9683 12.6797 14.0887V18.339H10.0142V9.75H12.5747V10.9207H12.6092C12.967 10.2457 13.837 9.53325 15.1367 9.53325C17.8375 9.53325 18.337 11.3108 18.337 13.6245V18.339H18.3362ZM7.00373 8.57475C6.14573 8.57475 5.45648 7.88025 5.45648 7.026C5.45648 6.1725 6.14648 5.47875 7.00373 5.47875C7.85873 5.47875 8.55173 6.1725 8.55173 7.026C8.55173 7.88025 7.85798 8.57475 7.00373 8.57475ZM8.34023 18.339H5.66723V9.75H8.34023V18.339ZM19.6697 3H4.32923C3.59498 3 3.00098 3.5805 3.00098 4.29675V19.7033C3.00098 20.4202 3.59498 21 4.32923 21H19.6675C20.401 21 21.001 20.4202 21.001 19.7033V4.29675C21.001 3.5805 20.401 3 19.6675 3H19.6697Z",
  },
].filter((link) => link.href);

const emailLink = `mailto:${site.email}`;
---

<section class="text-[var(--white)]" id="home">
  <div class="max-w-5xl mx-auto pt-6 md:pt-24 pb-8 md:pb-12">
    <div
      class="grid grid-cols-1 lg:grid-cols-[minmax(0,1.15fr)_minmax(320px,400px)] gap-8 lg:gap-14 items-center"
    >
      <div class="space-y-5 md:space-y-6">
        <p
          class="flex items-center gap-2.5 text-[11px] md:text-xs uppercase tracking-[0.3em] text-[var(--sec)]"
        >
          <span class="size-1.5 rounded-full bg-[var(--sec)]"></span>
          {hero.eyebrow}
          <span class="text-[var(--white-icon)]">/ {hero.edition}</span>
        </p>

        <h1
          class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-medium tracking-tight leading-[1.15] text-pretty"
        >
          {hero.headlineStart}<span class="text-[var(--sec)] shiny-sec"
            >{hero.headlineAccent}</span
          >
        </h1>

        <p
          class="max-w-2xl text-sm leading-relaxed md:text-lg text-[var(--white-icon)]"
        >
          {hero.subheadline}
        </p>

        <p
          class="text-[11px] md:text-xs uppercase tracking-[0.25em] text-[var(--white-icon)]"
        >
          {
            hero.tagline.map((word, index) => (
              <>
                {index > 0 && <span class="text-[var(--sec)]"> · </span>}
                {word}
              </>
            ))
          }
        </p>

        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 pt-2">
          <a
            href="#work"
            class="inline-flex items-center justify-center gap-2 rounded-full bg-[var(--sec)] px-6 py-3 text-sm font-semibold text-[#0d0e12] transition duration-300 hover:brightness-110 shadow-[0_0_20px_rgba(168,85,247,0.35)] hover:shadow-[0_0_28px_rgba(168,85,247,0.55)]"
          >
            Explore projects
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              class="size-4"
            >
              <path d="M16.0037 9.41421L7.39712 18.0208L5.98291 16.6066L14.5895 8H7.00373V6H18.0037V17H16.0037V9.41421Z"
              ></path>
            </svg>
          </a>
          <a
            href="#contact"
            class="inline-flex items-center justify-center gap-2 rounded-full border border-[var(--white-icon-tr)] bg-[#181920] px-6 py-3 text-sm text-[var(--white)] transition duration-300 hover:border-[var(--sec)] hover:text-white hover:shadow-[0_0_15px_rgba(168,85,247,0.2)]"
          >
            Let's connect
          </a>
        </div>

        <div class="flex items-center gap-2 pt-2">
          {
            socialLinks.map((link) => (
              <a
                target="_blank"
                rel="noopener noreferrer"
                href={link.href}
                aria-label={link.label}
                class="text-[var(--white-icon)] hover:text-[var(--sec)] transition duration-300 ease-in-out border border-[var(--white-icon-tr)] p-2.5 rounded-xl bg-[#181920] hover:bg-[#1f212a] hover:border-[var(--sec)]/50"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  class="size-5"
                >
                  <path d={link.path} />
                </svg>
              </a>
            ))
          }
          <a
            href={emailLink}
            aria-label="Email"
            class="text-[var(--white-icon)] hover:text-[var(--sec)] transition duration-300 ease-in-out border border-[var(--white-icon-tr)] p-2.5 rounded-xl bg-[#181920] hover:bg-[#1f212a] hover:border-[var(--sec)]/50"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="1.25em"
              height="1.25em"
              viewBox="0 0 24 24"
            >
              <path
                fill="currentColor"
                d="m18.73 5.41l-1.28 1L12 10.46L6.55 6.37l-1.28-1A2 2 0 0 0 2 7.05v11.59A1.36 1.36 0 0 0 3.36 20h3.19v-7.72L12 16.37l5.45-4.09V20h3.19A1.36 1.36 0 0 0 22 18.64V7.05a2 2 0 0 0-3.27-1.64"
              ></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Right Column: Pure Overlaid Portrait matched to background -->
      <div class="relative flex justify-center lg:justify-end items-end select-none mt-2 lg:mt-0">
        <div class="relative w-full max-w-[280px] sm:max-w-[340px] lg:max-w-[420px] mx-auto">
          <!-- Overlaid Transparent Cutout Portrait (Background matched to #121316) -->
          <img
            src="/images/sivagurubalan.webp?v=3"
            alt="R. Sivagurubalan — Robotics & Automation Engineer"
            class="relative z-10 w-full h-auto object-cover"
            loading="eager"
            width="768"
            height="1024"
          />

          <!-- Gentle gradient dissolve at the bottom into the page background -->
          <div
            class="absolute inset-x-0 bottom-0 h-28 sm:h-36 bg-gradient-to-t from-[var(--background)] via-[var(--background)]/80 to-transparent z-20 pointer-events-none"
          >
          </div>
        </div>
      </div>
    </div>

    <div class="mt-8 md:mt-10 border-y border-[#ffffff10]">
      <LogoWall />
    </div>
  </div>
</section>

<style is:global>
  .shiny-sec {
    background: linear-gradient(135deg, #c084fc 20%, #ffffff 50%, #a855f7 80%);
    background-size: 400% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: shine 3.4s linear infinite;
  }

  @keyframes shine {
    0% {
      background-position: 100% 50%;
    }
    30%,
    70% {
      background-position: 0% 50%;
    }
  }
</style>
