---
import { site } from "@/data/site";

const currentYear = new Date().getFullYear();

const socialLinks = [
  {
    href: site.githubUrl,
    label: "GitHub",
    path: "M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.5135 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z",
  },
  {
    href: site.linkedinUrl,
    label: "LinkedIn",
    path: "M18.3362 18.339H15.6707V14.1622C15.6707 13.1662 15.6505 11.8845 14.2817 11.8845C12.892 11.8845 12.6797 12.9683 12.6797 14.0887V18.339H10.0142V9.75H12.5747V10.9207H12.6092C12.967 10.2457 13.837 9.53325 15.1367 9.53325C17.8375 9.53325 18.337 11.3108 18.337 13.6245V18.339H18.3362ZM7.00373 8.57475C6.14573 8.57475 5.45648 7.88025 5.45648 7.026C5.45648 6.1725 6.14648 5.47875 7.00373 5.47875C7.85873 5.47875 8.55173 6.1725 8.55173 7.026C8.55173 7.88025 7.85798 8.57475 7.00373 8.57475ZM8.34023 18.339H5.66723V9.75H8.34023V18.339ZM19.6697 3H4.32923C3.59498 3 3.00098 3.5805 3.00098 4.29675V19.7033C3.00098 20.4202 3.59498 21 4.32923 21H19.6675C20.401 21 21.001 20.4202 21.001 19.7033V4.29675C21.001 3.5805 20.401 3 19.6675 3H19.6697Z",
  },
  {
    href: `mailto:${site.email}`,
    label: "Email",
    path: "m18.73 5.41l-1.28 1L12 10.46L6.55 6.37l-1.28-1A2 2 0 0 0 2 7.05v11.59A1.36 1.36 0 0 0 3.36 20h3.19v-7.72L12 16.37l5.45-4.09V20h3.19A1.36 1.36 0 0 0 22 18.64V7.05a2 2 0 0 0-3.27-1.64",
  },
].filter((link) => link.href);
---

<footer class="w-full py-14 border-t border-white/[0.08] text-[var(--white)]">
  <div class="max-w-5xl mx-auto">
    <!-- Two Column Balanced Footer -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12 items-start justify-between">
      
      <!-- Left Column: Identity, Bio & Social Links -->
      <div class="flex flex-col space-y-4">
        <!-- Brand / Name with subtle gradient -->
        <div>
          <h3 class="text-xl font-bold tracking-tight text-white flex items-center gap-2">
            <span>{site.name}</span>
            <span class="text-[var(--sec)] text-sm">✦</span>
          </h3>
          <p class="text-xs uppercase tracking-[0.2em] text-[var(--sec)] mt-1 font-mono">
            {site.role}
          </p>
        </div>

        <!-- Professional Summary Statement -->
        <p class="text-sm leading-relaxed text-[var(--white-icon)] max-w-md">
          Engineering intelligent machines, autonomous systems, and modern AI-driven software.
          Based in <span class="text-white font-medium">{site.location}</span>.
        </p>

        <!-- Availability status badge -->
        <div class="inline-flex items-center gap-2 text-xs text-white/70 pt-1">
          <span class="relative flex size-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full size-2 bg-emerald-500"></span>
          </span>
          <span>Open to engineering opportunities &amp; collaborative builds</span>
        </div>

        <!-- Social Icons (GitHub, LinkedIn, Email) with crisp direct SVGs -->
        <div class="flex items-center gap-3 pt-2">
          {
            socialLinks.map((link) => (
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex items-center justify-center size-11 rounded-xl bg-[#181920] border border-white/10 text-white/80 hover:text-[var(--sec)] hover:border-[var(--sec)]/50 hover:bg-[#1e2029] hover:shadow-[0_0_18px_rgba(168,85,247,0.3)] transition duration-200"
                aria-label={link.label}
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  width="20"
                  height="20"
                  fill="currentColor"
                  class="size-5 shrink-0 text-white/80 group-hover:text-[var(--sec)] transition-colors pointer-events-none"
                >
                  <path d={link.path} />
                </svg>
              </a>
            ))
          }
        </div>
      </div>

      <!-- Right Column: Current Focus card -->
      <div class="flex justify-start md:justify-end">
        <div class="w-full max-w-sm rounded-2xl border border-[var(--white-icon-tr)] bg-[#181920] p-6 shadow-[0_12px_35px_rgba(0,0,0,0.45)] hover:border-[var(--sec)]/30 transition duration-300">
          <p class="text-[10px] uppercase tracking-[0.25em] text-[var(--sec)] font-mono font-semibold">
            {site.currently.label}
          </p>
          <p class="mt-2 text-lg font-semibold text-[var(--white)]">
            {site.currently.title}
          </p>
          <p class="mt-2 text-sm leading-relaxed text-[var(--white-icon)]">
            {site.currently.description}
          </p>
          <a
            href="#work"
            class="mt-4 inline-flex items-center gap-1.5 text-xs uppercase tracking-wider text-[var(--sec)] hover:text-white transition-colors font-medium group"
          >
            <span>See the work</span>
            <span class="group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

    </div>

    <!-- Bottom Copyright Divider -->
    <div class="mt-12 pt-6 border-t border-white/[0.08]">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-[var(--white-icon)]">
        <p class="text-center sm:text-left">
          © {currentYear} <span class="text-white font-medium">{site.name}</span>. All rights reserved.
        </p>
        <p class="text-center sm:text-right text-white/50 flex items-center gap-1.5">
          <span>Engineered with precision &amp; passion</span>
          <span class="text-[var(--sec)]">·</span>
          <span>{site.location}</span>
        </p>
      </div>
    </div>
  </div>
</footer>
