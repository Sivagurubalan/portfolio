---
import { site } from "@/data/site";

interface NavItem {
  label: string;
  id: string;
  icon: string;
  number: string;
  subItems?: { label: string; href: string }[];
}

interface Props {
  prefix?: string;
}

const { prefix = "" } = Astro.props;

const navItems: NavItem[] = [
  {
    label: "Home",
    id: "home",
    number: "01",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>`,
  },
  {
    label: "Focus",
    id: "focus",
    number: "02",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/></svg>`,
    subItems: [
      { label: "Robotics & Automation", href: "#focus" },
      { label: "AI Systems & ML", href: "#focus" },
      { label: "Software & IoT", href: "#focus" },
    ],
  },
  {
    label: "Work",
    id: "work",
    number: "03",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 8 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/></svg>`,
  },
  {
    label: "Journey",
    id: "journey",
    number: "04",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="19" r="3"/><path d="M9 19h8.5a4.5 4.5 0 0 0 0-9H7a3 3 0 0 1 0-6h11"/><circle cx="18" cy="5" r="3"/></svg>`,
  },
  {
    label: "Contact",
    id: "contact",
    number: "05",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>`,
  },
];
---

<!-- Background overlay for mobile expanded state -->
<div
  id="sidebar-overlay"
  class="fixed inset-0 bg-black/60 backdrop-blur-sm z-[90] opacity-0 pointer-events-none transition-opacity duration-300 md:hidden"
>
</div>

<!-- Main Navigation Sidebar Dock -->
<aside
  id="main-sidebar"
  aria-label="Sidebar Navigation"
  class="fixed z-[100] transition-all duration-300 ease-in-out
    /* Mobile positioning: compact floating dock at bottom */
    bottom-4 left-1/2 -translate-x-1/2 w-[92vw] max-w-[360px] md:w-[64px] md:max-w-none
    /* Desktop positioning: docked on left center */
    md:bottom-auto md:left-5 lg:md:left-7 md:top-1/2 md:-translate-y-1/2 md:translate-x-0
    bg-[#181920]/95 border border-white/10 backdrop-blur-2xl
    rounded-2xl md:rounded-[26px] shadow-[0_16px_50px_rgba(0,0,0,0.7)]
    hover:border-[var(--sec)]/40 overflow-hidden"
>
  <div class="sidebar-inner flex flex-col h-full py-3.5 px-2.5">
    
    <!-- Top Header: macOS dots & brand mark -->
    <div class="header-section flex items-center justify-between pb-3 px-1.5 border-b border-white/[0.08]">
      <div class="flex items-center gap-2">
        <!-- 3 macOS Traffic Light Dots -->
        <div class="flex items-center gap-1.5" aria-hidden="true">
          <span class="size-2.5 rounded-full bg-[#ff5f56] transition-transform duration-200 hover:scale-125" title="Close"></span>
          <span class="size-2.5 rounded-full bg-[#ffbd2e] transition-transform duration-200 hover:scale-125" title="Minimize"></span>
          <span class="size-2.5 rounded-full bg-[#27c93f] transition-transform duration-200 hover:scale-125" title="Zoom"></span>
        </div>

        <!-- Brand Text (Visible only when expanded) -->
        <div class="expanded-brand hidden items-center gap-2 ml-2">
          <!-- 3 Slanted bars /// -->
          <svg viewBox="0 0 28 20" class="w-6 h-4 shrink-0" fill="currentColor">
            <polygon points="3,20 7,0 11,0 7,20" class="text-[var(--sec)] fill-current" />
            <polygon points="10,20 14,0 18,0 14,20" class="text-white fill-current" />
            <polygon points="17,20 21,0 25,0 21,20" class="text-[var(--sec-2)] fill-current" />
          </svg>
          <div class="leading-none">
            <span class="font-bold text-xs tracking-wider uppercase text-white font-mono">SIVAGURUBALAN</span>
          </div>
        </div>
      </div>

      <!-- Close button (Visible only when expanded) -->
      <button
        id="sidebar-close"
        type="button"
        aria-label="Close sidebar"
        class="expanded-close hidden p-1 rounded-lg text-white/60 hover:text-white hover:bg-white/10 transition"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 6 6 18M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Slanted bars glyph in collapsed state (desktop only) -->
    <div class="collapsed-brand hidden md:flex justify-center py-2.5">
      <a
        href={`${prefix}#home`}
        aria-label="Home"
        class="group relative flex items-center justify-center p-1.5 rounded-xl hover:bg-white/5 transition"
      >
        <!-- 3 Slanted geometric stripes /// matching reference image -->
        <svg viewBox="0 0 28 20" class="w-6 h-4 transition-transform duration-300 group-hover:scale-110" fill="currentColor">
          <polygon points="3,20 7,0 11,0 7,20" class="text-[var(--sec)] fill-current" />
          <polygon points="10,20 14,0 18,0 14,20" class="text-white fill-current" />
          <polygon points="17,20 21,0 25,0 21,20" class="text-[var(--sec-2)] fill-current" />
        </svg>
        <!-- Floating Tooltip -->
        <span
          class="hidden md:flex pointer-events-none absolute left-full ml-3.5 px-3 py-1.5 rounded-lg bg-[#1e2029] border border-white/10 text-xs font-medium text-white whitespace-nowrap opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-200 shadow-2xl z-50 items-center gap-2"
        >
          <span>Sivagurubalan</span>
          <span class="text-[10px] text-[var(--sec)] font-mono">Portfolio</span>
        </span>
      </a>
    </div>

    <!-- Section Title: MAIN MENU (Expanded view only) -->
    <div class="expanded-section-title hidden pt-3 pb-1 px-2">
      <span class="text-[10px] font-semibold text-white/40 tracking-[0.2em] uppercase font-mono">
        MAIN MENU
      </span>
    </div>

    <!-- Main Navigation Items List -->
    <nav class="flex-1 py-1" aria-label="Main Links">
      <ul class="flex flex-row md:flex-col items-center justify-between md:justify-start gap-1 md:gap-1.5">
        {
          navItems.map((item) => (
            <li class="w-full">
              <a
                href={`${prefix}#${item.id}`}
                data-section={item.id}
                aria-label={item.label}
                class="nav-link relative group flex items-center md:justify-center size-9 md:size-10 rounded-xl text-[var(--white-icon)] hover:text-white hover:bg-white/5 transition-all duration-200"
              >
                <!-- Active Indicator Pip (Left edge) -->
                <span class="active-pip hidden md:block absolute -left-1 top-1/2 -translate-y-1/2 w-1 h-4 rounded-full bg-[var(--sec)] opacity-0 scale-y-0 transition-all duration-300" />
                
                <!-- Icon -->
                <span class="flex items-center justify-center pointer-events-none shrink-0 mx-auto md:mx-0">
                  <fragment set:html={item.icon} />
                </span>

                <!-- Expanded Label (visible in drawer mode) -->
                <span class="expanded-label hidden ml-3 text-xs font-medium text-white/90 whitespace-nowrap group-hover:text-white">
                  {item.label}
                </span>

                <!-- Collapsed Floating Tooltip (matching reference image "Settings" pill) -->
                <span class="collapsed-tooltip hidden md:flex pointer-events-none absolute left-full ml-3.5 px-3 py-1.5 rounded-lg bg-[#1e2029] border border-white/10 text-xs font-medium text-white whitespace-nowrap opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-200 shadow-[0_10px_25px_rgba(0,0,0,0.6)] z-50 items-center gap-2">
                  <span>{item.label}</span>
                  <span class="text-[10px] text-[var(--sec)] font-mono">{item.number}</span>
                </span>
              </a>

              {/* Sub-items in expanded state (like Focus areas under Settings in mockup) */}
              {item.subItems && (
                <ul class="expanded-subitems hidden pl-8 pr-2 py-1 space-y-1 border-l border-white/10 ml-5 my-1">
                  {item.subItems.map((sub) => (
                    <li>
                      <a
                        href={sub.href}
                        class="block text-[11px] text-white/60 hover:text-[var(--sec)] hover:translate-x-1 transition-all py-0.5"
                      >
                        {sub.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Hairline divider (Desktop) -->
    <div class="hidden md:block w-7 h-[1px] bg-white/[0.08] mx-auto my-2 divider-line"></div>

    <!-- Section Title: CHANNELS & PROFILES (Expanded view only) -->
    <div class="expanded-section-title hidden pt-1 pb-1.5 px-2">
      <span class="text-[10px] font-semibold text-white/40 tracking-[0.2em] uppercase font-mono">
        CHANNELS
      </span>
    </div>

    <!-- Lower Section: Direct Quick Links / Badges (matching reference image F & P badges) -->
    <div class="lower-section flex flex-row md:flex-col items-center gap-1.5 pt-1">
      <!-- Direct GitHub Badge Link ("G" badge) -->
      <a
        href={site.githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub Profile"
        class="direct-link relative group flex items-center md:justify-center size-9 md:size-10 rounded-xl text-[var(--white-icon)] hover:text-white transition-all duration-200"
      >
        <span class="size-7 rounded-lg bg-[#a855f7]/20 border border-[#a855f7]/35 text-[#c084fc] font-bold text-xs flex items-center justify-center shadow-sm group-hover:bg-[#a855f7] group-hover:text-[#0d0e12] transition-colors shrink-0">
          G
        </span>
        <span class="expanded-label hidden ml-3 text-xs font-medium text-white/90 whitespace-nowrap group-hover:text-white flex-1">
          GitHub Profile
        </span>
        <span class="expanded-badge-icon hidden text-[11px] text-white/40 group-hover:text-[var(--sec)]">
          ↗
        </span>
        <!-- Collapsed Floating Tooltip -->
        <span class="collapsed-tooltip hidden md:flex pointer-events-none absolute left-full ml-3.5 px-3 py-1.5 rounded-lg bg-[#1e2029] border border-white/10 text-xs font-medium text-white whitespace-nowrap opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-200 shadow-2xl z-50 items-center gap-1.5">
          <span>GitHub</span>
          <span class="text-[10px] text-[var(--sec)]">↗</span>
        </span>
      </a>

      <!-- Direct Email Badge Link ("M" badge) -->
      <a
        href={`mailto:${site.email}`}
        aria-label="Direct Email"
        class="direct-link relative group flex items-center md:justify-center size-9 md:size-10 rounded-xl text-[var(--white-icon)] hover:text-white transition-all duration-200"
      >
        <span class="size-7 rounded-lg bg-[#c084fc]/20 border border-[#c084fc]/35 text-white font-bold text-xs flex items-center justify-center shadow-sm group-hover:bg-[#c084fc] group-hover:text-[#0d0e12] transition-colors shrink-0">
          M
        </span>
        <span class="expanded-label hidden ml-3 text-xs font-medium text-white/90 whitespace-nowrap group-hover:text-white flex-1">
          Direct Email
        </span>
        <span class="expanded-badge-icon hidden text-[11px] text-white/40 group-hover:text-[var(--sec)]">
          ✉
        </span>
        <!-- Collapsed Floating Tooltip -->
        <span class="collapsed-tooltip hidden md:flex pointer-events-none absolute left-full ml-3.5 px-3 py-1.5 rounded-lg bg-[#1e2029] border border-white/10 text-xs font-medium text-white whitespace-nowrap opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-200 shadow-2xl z-50 items-center gap-1.5">
          <span>Email Me</span>
          <span class="text-[10px] text-[var(--sec)]">✉</span>
        </span>
      </a>

      <!-- Sidebar Drawer Toggle Button (expands sidebar into full panel) -->
      <button
        id="sidebar-toggle"
        type="button"
        aria-label="Toggle Sidebar Menu"
        class="relative group flex items-center md:justify-center size-9 md:size-10 rounded-xl text-[var(--white-icon)] hover:text-white hover:bg-white/10 transition-all duration-200"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          class="size-4.5 toggle-icon transition-transform duration-300"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <rect width="18" height="18" x="3" y="3" rx="2" ry="2"/>
          <line x1="9" x2="9" y1="3" y2="21"/>
          <path d="m14 9 3 3-3 3"/>
        </svg>
        <span class="expanded-label hidden ml-3 text-xs font-medium text-white/70 whitespace-nowrap group-hover:text-white">
          Collapse Menu
        </span>
        <!-- Collapsed Floating Tooltip -->
        <span class="collapsed-tooltip hidden md:flex pointer-events-none absolute left-full ml-3.5 px-3 py-1.5 rounded-lg bg-[#1e2029] border border-white/10 text-xs font-medium text-white whitespace-nowrap opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-200 shadow-2xl z-50">
          <span class="toggle-tooltip-text">Expand Menu</span>
        </span>
      </button>
    </div>

  </div>
</aside>

<style>
  /* Active Link Styling (Graphite + Neon Purple pill) */
  .nav-link.active {
    color: var(--sec) !important;
    background-color: rgba(168, 85, 247, 0.16) !important;
    border: 1px solid rgba(168, 85, 247, 0.35) !important;
    box-shadow: 0 0 16px rgba(168, 85, 247, 0.25);
  }

  .nav-link.active .active-pip {
    opacity: 1 !important;
    transform: translateY(-50%) scaleY(1) !important;
  }

  /* Expanded State Styling */
  #main-sidebar.is-expanded {
    width: 270px !important;
    max-width: 90vw !important;
  }

  @media (max-width: 767px) {
    #main-sidebar.is-expanded {
      bottom: auto !important;
      top: 50% !important;
      left: 50% !important;
      transform: translate(-50%, -50%) !important;
      width: 320px !important;
      max-height: 85vh;
      overflow-y: auto;
    }
  }

  #main-sidebar.is-expanded .expanded-brand,
  #main-sidebar.is-expanded .expanded-close,
  #main-sidebar.is-expanded .expanded-section-title,
  #main-sidebar.is-expanded .expanded-label,
  #main-sidebar.is-expanded .expanded-badge-icon,
  #main-sidebar.is-expanded .expanded-subitems {
    display: flex !important;
  }

  #main-sidebar.is-expanded .expanded-subitems {
    display: block !important;
  }

  #main-sidebar.is-expanded .collapsed-brand,
  #main-sidebar.is-expanded .collapsed-tooltip {
    display: none !important;
  }

  #main-sidebar.is-expanded .divider-line {
    width: 100% !important;
  }

  #main-sidebar.is-expanded .nav-link,
  #main-sidebar.is-expanded .direct-link,
  #main-sidebar.is-expanded #sidebar-toggle {
    width: 100% !important;
    justify-content: flex-start !important;
    padding-left: 0.65rem !important;
    padding-right: 0.65rem !important;
  }

  #main-sidebar.is-expanded .toggle-icon {
    transform: rotate(180deg);
  }
</style>

<script>
  function initNav() {
    const sidebar = document.getElementById("main-sidebar");
    const toggleBtn = document.getElementById("sidebar-toggle");
    const closeBtn = document.getElementById("sidebar-close");
    const overlay = document.getElementById("sidebar-overlay");
    const tooltipText = document.querySelector(".toggle-tooltip-text");

    function setExpanded(expand: boolean) {
      if (!sidebar) return;
      if (expand) {
        sidebar.classList.add("is-expanded");
        if (overlay) {
          overlay.classList.remove("pointer-events-none", "opacity-0");
          overlay.classList.add("opacity-100");
        }
        if (tooltipText) tooltipText.textContent = "Collapse Menu";
      } else {
        sidebar.classList.remove("is-expanded");
        if (overlay) {
          overlay.classList.add("pointer-events-none", "opacity-0");
          overlay.classList.remove("opacity-100");
        }
        if (tooltipText) tooltipText.textContent = "Expand Menu";
      }
    }

    if (toggleBtn) {
      toggleBtn.onclick = (e) => {
        e.stopPropagation();
        const isExp = sidebar?.classList.contains("is-expanded");
        setExpanded(!isExp);
      };
    }

    if (closeBtn) {
      closeBtn.onclick = (e) => {
        e.stopPropagation();
        setExpanded(false);
      };
    }

    if (overlay) {
      overlay.onclick = () => setExpanded(false);
    }

    // Close on escape key
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && sidebar?.classList.contains("is-expanded")) {
        setExpanded(false);
      }
    });

    // Smooth scroll for internal hashes & close mobile drawer on click
    document.querySelectorAll('#main-sidebar a[href*="#"]').forEach((anchor) => {
      anchor.addEventListener("click", function (e) {
        const href = anchor.getAttribute("href") || "";
        const hashIdx = href.indexOf("#");
        if (hashIdx !== -1) {
          const targetId = href.substring(hashIdx + 1);
          const targetElement = document.getElementById(targetId);
          if (targetElement) {
            e.preventDefault();
            targetElement.scrollIntoView({ behavior: "smooth" });
            history.pushState(null, "", `#${targetId}`);
            // On mobile screen collapse drawer
            if (window.innerWidth < 768) {
              setExpanded(false);
            }
          }
        }
      });
    });

    // IntersectionObserver scroll spy
    const sections = document.querySelectorAll("section[id]");
    const navLinks = document.querySelectorAll("#main-sidebar a[data-section]");
    if (!sections.length || !navLinks.length) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const id = entry.target.getAttribute("id");
            navLinks.forEach((link) => {
              if (link.getAttribute("data-section") === id) {
                link.classList.add("active");
              } else {
                link.classList.remove("active");
              }
            });
          }
        });
      },
      { threshold: 0.25 }
    );

    sections.forEach((s) => observer.observe(s));
  }

  initNav();
  document.addEventListener("astro:page-load", initNav);
</script>
