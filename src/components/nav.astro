---
import { site } from "@/data/site";

interface NavItem {
  label: string;
  id: string;
  icon: string;
  number: string;
  subItems?: { label: string; href: string }[];
}

interface Props {
  prefix?: string;
}

const { prefix = "" } = Astro.props;

const navItems: NavItem[] = [
  {
    label: "Home",
    id: "home",
    number: "01",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>`,
  },
  {
    label: "Focus",
    id: "focus",
    number: "02",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/></svg>`,
    subItems: [
      { label: "Robotics & Automation", href: "#focus" },
      { label: "AI Systems & ML", href: "#focus" },
      { label: "Software & IoT", href: "#focus" },
    ],
  },
  {
    label: "Work",
    id: "work",
    number: "03",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 8 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/></svg>`,
  },
  {
    label: "Journey",
    id: "journey",
    number: "04",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="19" r="3"/><path d="M9 19h8.5a4.5 4.5 0 0 0 0-9H7a3 3 0 0 1 0-6h11"/><circle cx="18" cy="5" r="3"/></svg>`,
  },
  {
    label: "Contact",
    id: "contact",
    number: "05",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>`,
  },
];
---

<!-- ========================================== -->
<!-- 1. MOBILE TOP NAVIGATION BAR (Screens < md) -->
<!-- ========================================== -->
<header
  id="mobile-header"
  class="md:hidden fixed top-0 inset-x-0 h-14 bg-[#121316]/90 backdrop-blur-xl border-b border-white/[0.08] z-[95] px-4 flex items-center justify-between"
>
  <div class="flex items-center gap-3">
    <!-- 3 macOS traffic light dots -->
    <div class="flex items-center gap-1.5" aria-hidden="true">
      <span class="size-2 rounded-full bg-[#ff5f56]"></span>
      <span class="size-2 rounded-full bg-[#ffbd2e]"></span>
      <span class="size-2 rounded-full bg-[#27c93f]"></span>
    </div>

    <!-- 3 Slanted bars /// + Name -->
    <a href={`${prefix}#home`} class="flex items-center gap-2" aria-label="Sivagurubalan Home">
      <svg viewBox="0 0 28 20" class="w-5 h-3.5 shrink-0" fill="currentColor">
        <polygon points="3,20 7,0 11,0 7,20" class="text-[var(--sec)] fill-current" />
        <polygon points="10,20 14,0 18,0 14,20" class="text-white fill-current" />
        <polygon points="17,20 21,0 25,0 21,20" class="text-[var(--sec-2)] fill-current" />
      </svg>
      <span class="font-bold text-xs tracking-wider uppercase text-white font-mono">SIVAGURUBALAN</span>
    </a>
  </div>

  <!-- Mobile Drawer Toggle Button -->
  <button
    id="mobile-drawer-btn"
    type="button"
    aria-label="Open Navigation Menu"
    class="size-9 rounded-xl flex items-center justify-center text-white/80 hover:text-white bg-white/5 border border-white/10 active:scale-95 transition"
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="size-4.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <line x1="4" x2="20" y1="12" y2="12"/>
      <line x1="4" x2="20" y1="6" y2="6"/>
      <line x1="4" x2="20" y1="18" y2="18"/>
    </svg>
  </button>
</header>

<!-- ========================================== -->
<!-- 2. MOBILE BOTTOM FLOATING DOCK (Screens < md) -->
<!-- ========================================== -->
<nav
  id="mobile-dock"
  aria-label="Mobile Quick Nav"
  class="md:hidden fixed bottom-3 left-1/2 -translate-x-1/2 w-[calc(100%-2rem)] max-w-[360px] h-14 bg-[#16171e]/90 backdrop-blur-2xl border border-white/10 rounded-full shadow-[0_12px_36px_rgba(0,0,0,0.7)] px-2 py-1.5 flex items-center justify-around z-[90]"
>
  {
    navItems.map((item) => (
      <a
        href={`${prefix}#${item.id}`}
        data-section={item.id}
        aria-label={item.label}
        class="nav-link relative flex flex-col items-center justify-center size-10 rounded-full text-white/60 hover:text-white active:scale-90 transition-all duration-200"
      >
        <span class="flex items-center justify-center pointer-events-none">
          <fragment set:html={item.icon} />
        </span>
        <span class="active-dot absolute bottom-1 size-1 rounded-full bg-[var(--sec)] opacity-0 transition-opacity" />
      </a>
    ))
  }
</nav>

<!-- ========================================== -->
<!-- 3. MOBILE FULL SLIDE-OVER DRAWER          -->
<!-- ========================================== -->
<div
  id="mobile-drawer-overlay"
  class="md:hidden fixed inset-0 bg-black/70 backdrop-blur-sm z-[110] opacity-0 pointer-events-none transition-opacity duration-300"
>
</div>

<aside
  id="mobile-drawer"
  aria-label="Mobile Drawer"
  class="md:hidden fixed top-0 left-0 bottom-0 w-[82vw] max-w-[320px] bg-[#16171f] border-r border-white/10 z-[120] -translate-x-full transition-transform duration-300 ease-out flex flex-col p-5 shadow-2xl overflow-y-auto"
>
  <!-- Drawer Header -->
  <div class="flex items-center justify-between pb-4 border-b border-white/10">
    <div class="flex items-center gap-2">
      <!-- 3 macOS dots -->
      <div class="flex items-center gap-1.5" aria-hidden="true">
        <span class="size-2.5 rounded-full bg-[#ff5f56]"></span>
        <span class="size-2.5 rounded-full bg-[#ffbd2e]"></span>
        <span class="size-2.5 rounded-full bg-[#27c93f]"></span>
      </div>
      <span class="font-bold text-xs tracking-wider uppercase text-white font-mono ml-2">SIVAGURUBALAN</span>
    </div>
    <button
      id="mobile-drawer-close"
      type="button"
      aria-label="Close menu"
      class="p-1 rounded-lg text-white/60 hover:text-white hover:bg-white/10 transition"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 6 6 18M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Menu Content -->
  <div class="py-4 space-y-5 flex-1">
    <div>
      <span class="text-[10px] font-semibold text-white/40 tracking-[0.2em] uppercase font-mono block mb-2 px-1">
        MAIN MENU
      </span>
      <ul class="space-y-1">
        {
          navItems.map((item) => (
            <li>
              <a
                href={`${prefix}#${item.id}`}
                data-section={item.id}
                class="drawer-link flex items-center justify-between px-3 py-2.5 rounded-xl text-sm font-medium text-white/80 hover:text-white hover:bg-white/5 active:bg-[var(--sec)]/15 active:text-[var(--sec)] transition"
              >
                <div class="flex items-center gap-3">
                  <span class="text-white/60">
                    <fragment set:html={item.icon} />
                  </span>
                  <span>{item.label}</span>
                </div>
                <span class="text-[10px] text-[var(--sec)] font-mono">{item.number}</span>
              </a>
              {item.subItems && (
                <ul class="pl-9 pr-2 py-1 space-y-1 border-l border-white/10 ml-6 my-1">
                  {item.subItems.map((sub) => (
                    <li>
                      <a
                        href={sub.href}
                        class="drawer-sublink block text-xs text-white/60 hover:text-[var(--sec)] py-1"
                      >
                        {sub.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Channels Section -->
    <div class="pt-2 border-t border-white/10">
      <span class="text-[10px] font-semibold text-white/40 tracking-[0.2em] uppercase font-mono block mb-2 px-1">
        CHANNELS &amp; PROFILES
      </span>
      <div class="space-y-1.5">
        <a
          href={site.githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-between px-3 py-2 rounded-xl text-xs font-medium text-white/80 hover:text-white hover:bg-white/5 transition"
        >
          <div class="flex items-center gap-2.5">
            <span class="size-6 rounded-md bg-[#a855f7]/20 border border-[#a855f7]/35 text-[#c084fc] font-bold text-xs flex items-center justify-center">
              G
            </span>
            <span>GitHub Profile</span>
          </div>
          <span class="text-white/40 text-xs">↗</span>
        </a>

        <a
          href={`mailto:${site.email}`}
          class="flex items-center justify-between px-3 py-2 rounded-xl text-xs font-medium text-white/80 hover:text-white hover:bg-white/5 transition"
        >
          <div class="flex items-center gap-2.5">
            <span class="size-6 rounded-md bg-[#c084fc]/20 border border-[#c084fc]/35 text-white font-bold text-xs flex items-center justify-center">
              M
            </span>
            <span>Direct Email</span>
          </div>
          <span class="text-white/40 text-xs">✉</span>
        </a>

        <a
          href={site.linkedinUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-between px-3 py-2 rounded-xl text-xs font-medium text-white/80 hover:text-white hover:bg-white/5 transition"
        >
          <div class="flex items-center gap-2.5">
            <span class="size-6 rounded-md bg-blue-500/20 border border-blue-500/35 text-blue-400 font-bold text-xs flex items-center justify-center">
              in
            </span>
            <span>LinkedIn Profile</span>
          </div>
          <span class="text-white/40 text-xs">↗</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Drawer Footer Info -->
  <div class="pt-4 border-t border-white/10 text-[11px] text-white/40 font-mono">
    <span>© 2026 {site.firstName}</span>
  </div>
</aside>

<!-- ========================================== -->
<!-- 4. DESKTOP VERTICAL SIDEBAR DOCK (md+)     -->
<!-- ========================================== -->
<aside
  id="desktop-sidebar"
  aria-label="Desktop Navigation"
  class="hidden md:block fixed z-[100] transition-all duration-300 ease-in-out
    left-4 lg:left-6 top-1/2 -translate-y-1/2 w-[62px]
    bg-[#181920]/95 border border-white/10 backdrop-blur-2xl
    rounded-[26px] shadow-[0_16px_50px_rgba(0,0,0,0.7)]
    hover:border-[var(--sec)]/40 overflow-hidden max-h-[94vh]"
>
  <div class="sidebar-inner flex flex-col h-full py-3 px-2">
    
    <!-- Top Header: macOS dots & brand mark -->
    <div class="header-section flex items-center justify-between pb-2.5 px-1 border-b border-white/[0.08]">
      <div class="flex items-center gap-2">
        <!-- 3 macOS Traffic Light Dots -->
        <div class="flex items-center gap-1.5" aria-hidden="true">
          <span class="size-2.5 rounded-full bg-[#ff5f56] transition-transform duration-200 hover:scale-125" title="Close"></span>
          <span class="size-2.5 rounded-full bg-[#ffbd2e] transition-transform duration-200 hover:scale-125" title="Minimize"></span>
          <span class="size-2.5 rounded-full bg-[#27c93f] transition-transform duration-200 hover:scale-125" title="Zoom"></span>
        </div>

        <!-- Brand Text (Expanded state only) -->
        <div class="expanded-brand hidden items-center gap-2 ml-2">
          <svg viewBox="0 0 28 20" class="w-5 h-3.5 shrink-0" fill="currentColor">
            <polygon points="3,20 7,0 11,0 7,20" class="text-[var(--sec)] fill-current" />
            <polygon points="10,20 14,0 18,0 14,20" class="text-white fill-current" />
            <polygon points="17,20 21,0 25,0 21,20" class="text-[var(--sec-2)] fill-current" />
          </svg>
          <span class="font-bold text-xs tracking-wider uppercase text-white font-mono">SIVAGURUBALAN</span>
        </div>
      </div>

      <!-- Close button (Expanded state only) -->
      <button
        id="desktop-close"
        type="button"
        aria-label="Collapse sidebar"
        class="expanded-close hidden p-1 rounded-lg text-white/60 hover:text-white hover:bg-white/10 transition"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 6 6 18M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Slanted bars glyph in collapsed state -->
    <div class="collapsed-brand flex justify-center py-2">
      <a
        href={`${prefix}#home`}
        aria-label="Home"
        class="group relative flex items-center justify-center p-1 rounded-xl hover:bg-white/5 transition"
      >
        <svg viewBox="0 0 28 20" class="w-5 h-3.5 transition-transform duration-300 group-hover:scale-110" fill="currentColor">
          <polygon points="3,20 7,0 11,0 7,20" class="text-[var(--sec)] fill-current" />
          <polygon points="10,20 14,0 18,0 14,20" class="text-white fill-current" />
          <polygon points="17,20 21,0 25,0 21,20" class="text-[var(--sec-2)] fill-current" />
        </svg>
        <span
          class="pointer-events-none absolute left-full ml-3 px-3 py-1.5 rounded-lg bg-[#1e2029] border border-white/10 text-xs font-medium text-white whitespace-nowrap opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-200 shadow-2xl z-50 items-center gap-2"
        >
          <span>Sivagurubalan</span>
          <span class="text-[10px] text-[var(--sec)] font-mono">Portfolio</span>
        </span>
      </a>
    </div>

    <!-- Section Title: MAIN MENU (Expanded view only) -->
    <div class="expanded-section-title hidden pt-2 pb-1 px-2">
      <span class="text-[10px] font-semibold text-white/40 tracking-[0.2em] uppercase font-mono">
        MAIN MENU
      </span>
    </div>

    <!-- Navigation Items List -->
    <nav class="flex-1 py-1" aria-label="Main Links">
      <ul class="flex flex-col items-center gap-1.5">
        {
          navItems.map((item) => (
            <li class="w-full">
              <a
                href={`${prefix}#${item.id}`}
                data-section={item.id}
                aria-label={item.label}
                class="desktop-nav-link relative group flex items-center size-9.5 rounded-xl text-[var(--white-icon)] hover:text-white hover:bg-white/5 transition-all duration-200"
              >
                <!-- Active Pip -->
                <span class="active-pip absolute -left-1 top-1/2 -translate-y-1/2 w-1 h-4 rounded-full bg-[var(--sec)] opacity-0 scale-y-0 transition-all duration-300" />
                
                <!-- Icon -->
                <span class="flex items-center justify-center pointer-events-none shrink-0 mx-auto group-hover:text-white">
                  <fragment set:html={item.icon} />
                </span>

                <!-- Expanded Label -->
                <span class="expanded-label hidden ml-3 text-xs font-medium text-white/90 whitespace-nowrap group-hover:text-white">
                  {item.label}
                </span>

                <!-- Floating Tooltip -->
                <span class="collapsed-tooltip flex pointer-events-none absolute left-full ml-3 px-3 py-1.5 rounded-lg bg-[#1e2029] border border-white/10 text-xs font-medium text-white whitespace-nowrap opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-200 shadow-xl z-50 items-center gap-2">
                  <span>{item.label}</span>
                  <span class="text-[10px] text-[var(--sec)] font-mono">{item.number}</span>
                </span>
              </a>

              {item.subItems && (
                <ul class="expanded-subitems hidden pl-8 pr-2 py-1 space-y-1 border-l border-white/10 ml-5 my-1">
                  {item.subItems.map((sub) => (
                    <li>
                      <a
                        href={sub.href}
                        class="block text-[11px] text-white/60 hover:text-[var(--sec)] hover:translate-x-1 transition-all py-0.5"
                      >
                        {sub.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Hairline divider -->
    <div class="w-6 h-[1px] bg-white/[0.08] mx-auto my-1.5 divider-line"></div>

    <!-- Section Title: CHANNELS (Expanded view only) -->
    <div class="expanded-section-title hidden pt-1 pb-1 px-2">
      <span class="text-[10px] font-semibold text-white/40 tracking-[0.2em] uppercase font-mono">
        CHANNELS
      </span>
    </div>

    <!-- Lower Section: Direct Badges -->
    <div class="lower-section flex flex-col items-center gap-1.5 pt-1">
      <!-- Direct GitHub Badge -->
      <a
        href={site.githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub Profile"
        class="desktop-direct-link relative group flex items-center size-9.5 rounded-xl text-[var(--white-icon)] hover:text-white transition-all duration-200"
      >
        <span class="size-7 rounded-lg bg-[#a855f7]/20 border border-[#a855f7]/35 text-[#c084fc] font-bold text-xs flex items-center justify-center shadow-sm group-hover:bg-[#a855f7] group-hover:text-[#0d0e12] transition-colors shrink-0 mx-auto">
          G
        </span>
        <span class="expanded-label hidden ml-3 text-xs font-medium text-white/90 whitespace-nowrap group-hover:text-white flex-1">
          GitHub Profile
        </span>
        <span class="expanded-badge-icon hidden text-[11px] text-white/40 group-hover:text-[var(--sec)]">
          ↗
        </span>
        <span class="collapsed-tooltip flex pointer-events-none absolute left-full ml-3 px-3 py-1.5 rounded-lg bg-[#1e2029] border border-white/10 text-xs font-medium text-white whitespace-nowrap opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-200 shadow-xl z-50 items-center gap-1.5">
          <span>GitHub</span>
          <span class="text-[10px] text-[var(--sec)]">↗</span>
        </span>
      </a>

      <!-- Direct Email Badge -->
      <a
        href={`mailto:${site.email}`}
        aria-label="Direct Email"
        class="desktop-direct-link relative group flex items-center size-9.5 rounded-xl text-[var(--white-icon)] hover:text-white transition-all duration-200"
      >
        <span class="size-7 rounded-lg bg-[#c084fc]/20 border border-[#c084fc]/35 text-white font-bold text-xs flex items-center justify-center shadow-sm group-hover:bg-[#c084fc] group-hover:text-[#0d0e12] transition-colors shrink-0 mx-auto">
          M
        </span>
        <span class="expanded-label hidden ml-3 text-xs font-medium text-white/90 whitespace-nowrap group-hover:text-white flex-1">
          Direct Email
        </span>
        <span class="expanded-badge-icon hidden text-[11px] text-white/40 group-hover:text-[var(--sec)]">
          ✉
        </span>
        <span class="collapsed-tooltip flex pointer-events-none absolute left-full ml-3 px-3 py-1.5 rounded-lg bg-[#1e2029] border border-white/10 text-xs font-medium text-white whitespace-nowrap opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-200 shadow-xl z-50 items-center gap-1.5">
          <span>Email Me</span>
          <span class="text-[10px] text-[var(--sec)]">✉</span>
        </span>
      </a>

      <!-- Desktop Sidebar Toggle Button -->
      <button
        id="desktop-toggle"
        type="button"
        aria-label="Toggle Sidebar Menu"
        class="relative group flex items-center size-9.5 rounded-xl text-[var(--white-icon)] hover:text-white hover:bg-white/10 transition-all duration-200"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          class="size-4.5 toggle-icon transition-transform duration-300 mx-auto"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <rect width="18" height="18" x="3" y="3" rx="2" ry="2"/>
          <line x1="9" x2="9" y1="3" y2="21"/>
          <path d="m14 9 3 3-3 3"/>
        </svg>
        <span class="expanded-label hidden ml-3 text-xs font-medium text-white/70 whitespace-nowrap group-hover:text-white">
          Collapse Menu
        </span>
        <span class="collapsed-tooltip flex pointer-events-none absolute left-full ml-3 px-3 py-1.5 rounded-lg bg-[#1e2029] border border-white/10 text-xs font-medium text-white whitespace-nowrap opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-200 shadow-xl z-50">
          <span class="desktop-tooltip-text">Expand Menu</span>
        </span>
      </button>
    </div>

  </div>
</aside>

<style>
  /* Active Link Styles */
  .desktop-nav-link.active,
  #mobile-dock .nav-link.active {
    color: var(--sec) !important;
    background-color: rgba(168, 85, 247, 0.16) !important;
  }

  .desktop-nav-link.active {
    border: 1px solid rgba(168, 85, 247, 0.35) !important;
    box-shadow: 0 0 16px rgba(168, 85, 247, 0.25);
  }

  .desktop-nav-link.active .active-pip {
    opacity: 1 !important;
    transform: translateY(-50%) scaleY(1) !important;
  }

  #mobile-dock .nav-link.active .active-dot {
    opacity: 1 !important;
  }

  /* Desktop Expanded State */
  #desktop-sidebar.is-expanded {
    width: 260px !important;
  }

  #desktop-sidebar.is-expanded .expanded-brand,
  #desktop-sidebar.is-expanded .expanded-close,
  #desktop-sidebar.is-expanded .expanded-section-title,
  #desktop-sidebar.is-expanded .expanded-label,
  #desktop-sidebar.is-expanded .expanded-badge-icon,
  #desktop-sidebar.is-expanded .expanded-subitems {
    display: flex !important;
  }

  #desktop-sidebar.is-expanded .expanded-subitems {
    display: block !important;
  }

  #desktop-sidebar.is-expanded .collapsed-brand,
  #desktop-sidebar.is-expanded .collapsed-tooltip {
    display: none !important;
  }

  #desktop-sidebar.is-expanded .divider-line {
    width: 100% !important;
  }

  #desktop-sidebar.is-expanded .desktop-nav-link,
  #desktop-sidebar.is-expanded .desktop-direct-link,
  #desktop-sidebar.is-expanded #desktop-toggle {
    width: 100% !important;
    justify-content: flex-start !important;
    padding-left: 0.65rem !important;
    padding-right: 0.65rem !important;
  }

  #desktop-sidebar.is-expanded .desktop-nav-link span:first-of-type,
  #desktop-sidebar.is-expanded .desktop-direct-link span:first-of-type,
  #desktop-sidebar.is-expanded .toggle-icon {
    margin-left: 0 !important;
    margin-right: 0 !important;
  }

  #desktop-sidebar.is-expanded .toggle-icon {
    transform: rotate(180deg);
  }

  /* Mobile Drawer Open State */
  #mobile-drawer.is-open {
    transform: translateX(0) !important;
  }
</style>

<script>
  function initNav() {
    // --- Mobile Drawer Controls ---
    const mobileBtn = document.getElementById("mobile-drawer-btn");
    const mobileDrawer = document.getElementById("mobile-drawer");
    const mobileClose = document.getElementById("mobile-drawer-close");
    const mobileOverlay = document.getElementById("mobile-drawer-overlay");

    function setMobileDrawer(open: boolean) {
      if (!mobileDrawer || !mobileOverlay) return;
      if (open) {
        mobileDrawer.classList.add("is-open");
        mobileOverlay.classList.remove("pointer-events-none", "opacity-0");
        mobileOverlay.classList.add("opacity-100");
        document.body.style.overflow = "hidden";
      } else {
        mobileDrawer.classList.remove("is-open");
        mobileOverlay.classList.add("pointer-events-none", "opacity-0");
        mobileOverlay.classList.remove("opacity-100");
        document.body.style.overflow = "";
      }
    }

    if (mobileBtn) mobileBtn.onclick = () => setMobileDrawer(true);
    if (mobileClose) mobileClose.onclick = () => setMobileDrawer(false);
    if (mobileOverlay) mobileOverlay.onclick = () => setMobileDrawer(false);

    // --- Desktop Sidebar Expand/Collapse ---
    const desktopSidebar = document.getElementById("desktop-sidebar");
    const desktopToggle = document.getElementById("desktop-toggle");
    const desktopClose = document.getElementById("desktop-close");
    const desktopTooltip = document.querySelector(".desktop-tooltip-text");

    function setDesktopExpanded(expand: boolean) {
      if (!desktopSidebar) return;
      if (expand) {
        desktopSidebar.classList.add("is-expanded");
        if (desktopTooltip) desktopTooltip.textContent = "Collapse Menu";
      } else {
        desktopSidebar.classList.remove("is-expanded");
        if (desktopTooltip) desktopTooltip.textContent = "Expand Menu";
      }
    }

    if (desktopToggle) {
      desktopToggle.onclick = (e) => {
        e.stopPropagation();
        const isExp = desktopSidebar?.classList.contains("is-expanded");
        setDesktopExpanded(!isExp);
      };
    }

    if (desktopClose) {
      desktopClose.onclick = (e) => {
        e.stopPropagation();
        setDesktopExpanded(false);
      };
    }

    // --- Smooth Scrolling for all internal anchors ---
    document.querySelectorAll('a[href*="#"]').forEach((anchor) => {
      anchor.addEventListener("click", function (e) {
        const href = anchor.getAttribute("href") || "";
        const hashIdx = href.indexOf("#");
        if (hashIdx !== -1) {
          const targetId = href.substring(hashIdx + 1);
          const targetElement = document.getElementById(targetId);
          if (targetElement) {
            e.preventDefault();
            // Close mobile drawer if open
            setMobileDrawer(false);
            targetElement.scrollIntoView({ behavior: "smooth" });
            history.pushState(null, "", `#${targetId}`);
          }
        }
      });
    });

    // --- ScrollSpy Observer ---
    const sections = document.querySelectorAll("section[id]");
    const navLinks = document.querySelectorAll("[data-section]");
    if (!sections.length || !navLinks.length) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const id = entry.target.getAttribute("id");
            navLinks.forEach((link) => {
              if (link.getAttribute("data-section") === id) {
                link.classList.add("active");
              } else {
                link.classList.remove("active");
              }
            });
          }
        });
      },
      { threshold: 0.25 }
    );

    sections.forEach((s) => observer.observe(s));
  }

  initNav();
  document.addEventListener("astro:page-load", initNav);
</script>
