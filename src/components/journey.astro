---
import { site } from "@/data/site";
---

<section id="journey" class="py-14 md:py-16 border-t border-[#ffffff10] text-[var(--white)]">
  <div class="max-w-5xl mx-auto">
    <p class="text-xs uppercase tracking-[0.3em] text-[var(--sec)] mb-3">
      06 — Engineering journey
    </p>
    <h2 class="text-3xl md:text-5xl font-medium text-pretty">
      How the work has moved.
    </h2>

    <ol class="mt-9 relative border-l border-[#ffffff14] pl-6 md:pl-8 space-y-8">
      {
        site.journey.map((entry) => (
          <li class="relative">
            <span class="absolute -left-[1.72rem] md:-left-[2.22rem] top-1.5 size-2.5 rounded-full border border-[var(--sec)] bg-[var(--background)]" />
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
              <span class="font-mono text-[11px] uppercase tracking-wider text-[var(--sec)]">
                {entry.period}
              </span>
              <span class="rounded border border-[#ffffff12] px-2 py-0.5 text-[10px] uppercase tracking-wider text-[#8d949c]">
                {entry.tag}
              </span>
            </div>
            <h3 class="mt-2 text-lg md:text-xl font-semibold">{entry.title}</h3>
            <p class="mt-1.5 max-w-2xl text-sm leading-relaxed text-[var(--white-icon)]">
              {entry.detail}
            </p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
